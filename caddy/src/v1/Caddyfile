# ===========================
# Caddyfile for Docker Compose
# ===========================

# Use localhost for dev, replace with real domain in production
https://localhost {
  
  # Optional: enable automatic local CA trust for dev
  tls internal

  # Main reverse proxy to Nginx
  reverse_proxy nginx:81 {
    # Disable buffering for streaming content
    transport http {
      read_buffer 4096
    }
  }

  # Optional headers for security
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # Logging
  log {
    output stdout
    format json
  }

  # Optional: enable gzip/zstd compression
  encode gzip zstd
}

# Optional HTTP -> HTTPS redirect
http://localhost {
  redir https://localhost{uri} permanent
}

